# Nothing here is required. Transcription runs locally with whisper.cpp.

# Language of the videos (two-letter code: uk, ru, en, pl...). Set by `npm run setup -- --lang xx`.
# Used by transcription and the font check. Empty = auto-detect.
VIDEO_LANGUAGE=

# Fill only the keys for optional services you choose.
# See docs/TOOLS-AND-API-KEYS.md. Copy this file to .env locally. Never commit your key.

# Optional: path to a Whisper model if it is not in models/ or ../models/
WHISPER_MODEL=

# Optional cloud transcription (npm run transcribe:elevenlabs) and SFX generation.
# https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=

# Optional Whisper API transcription or OpenAI generation.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional provider for generated video and image assets.
# Requires your own credits: https://docs.kie.ai/
KIE_API_KEY=

# Optional Gemini image descriptions.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
